# Template only. Copy to .env beside the TOML file and replace the placeholders.
# Never commit actual credentials. The repository already ignores .env files.
DK_SHAREPOINT_TENANT_ID=replace-with-tenant-id
DK_SHAREPOINT_CLIENT_ID=replace-with-application-id
DK_SHAREPOINT_CLIENT_SECRET=replace-with-client-secret

# Optional: used only by the PostgreSQL configuration example.
# DK_DATABASE_DSN=postgresql://user:password@db.example.internal/domain_kernel?sslmode=verify-full

# Optional: used only by an explicitly configured aws_static provider.
# DK_AWS_ACCESS_KEY_ID=replace-with-access-key-id
# DK_AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
# DK_AWS_SESSION_TOKEN=replace-with-session-token
