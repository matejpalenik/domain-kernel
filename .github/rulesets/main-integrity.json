{
  "name": "Main: pull requests and required checks",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {"include": ["refs/heads/main"], "exclude": []}
  },
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "require_extra_approval_for_unattributed_changes": true,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {"context": "Action dependency lockfile", "integration_id": 15368},
          {"context": "Quality (Python 3.13)", "integration_id": 15368},
          {"context": "Quality (Python 3.14)", "integration_id": 15368},
          {"context": "Dependency security", "integration_id": 15368},
          {"context": "Notebook preview", "integration_id": 15368},
          {"context": "Documentation quality", "integration_id": 15368},
          {"context": "Commit conventions", "integration_id": 15368},
          {"context": "Documentation dependency security", "integration_id": 15368}
        ]
      }
    }
  ]
}
