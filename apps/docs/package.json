{
  "name": "@domain-kernel/docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3001",
    "build": "next build --webpack",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check . && pnpm -w format:tooling",
    "typecheck": "next typegen && tsc6 --noEmit",
    "content:check": "node scripts/check-content.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test",
    "check": "node -e \"console.log('Documentation checks passed.')\""
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@algolia/autocomplete-core": "1.19.12",
    "@headlessui/react": "2.2.10",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.0",
    "@next/mdx": "16.4.3",
    "@sindresorhus/slugify": "3.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/mdx": "2.0.13",
    "@types/react-highlight-words": "0.20.0",
    "acorn": "8.15.0",
    "clsx": "2.1.1",
    "fast-glob": "3.3.3",
    "flexsearch": "0.8.205",
    "framer-motion": "14.8.0",
    "mdast-util-to-string": "4.0.0",
    "mdx-annotations": "0.1.4",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-highlight-words": "1.0.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.0",
    "shiki": "4.5.0",
    "simple-functional-loader": "1.2.1",
    "tailwindcss": "4.3.3",
    "unist-util-filter": "5.0.1",
    "unist-util-visit": "5.2.0",
    "zustand": "5.0.6"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "type": "module",
  "engines": {
    "node": "26.6.0",
    "pnpm": "12.4.0"
  }
}
